# --- Which environment this operator deployment serves ---
# One operator deployment == one environment. Drives spoke capacity/
# scale-out thresholds (prod: 1000/spoke, scale at 995; stage: 3/spoke,
# notify at 2 -- stage has no autoscaling).
ENVIRONMENT=stage

# --- CORS (for a browser frontend consuming the API / SSE status stream) ---
# "*" is fine for local dev/POC; set to your real frontend origin(s) for a
# real deployment, e.g. CORS_ALLOW_ORIGINS=["https://portal.your-org.com"]
CORS_ALLOW_ORIGINS=["*"]

# --- Tenant CR (created on the hub cluster before GitOps takes over) ---
HUB_NAMESPACE=platform-mgmt
CR_API_VERSION=platform.saas.com/v1alpha1
CR_KIND=Tenant
DEFAULT_APPLICATION=workplace
DEFAULT_VERSION=1.0.0
DEFAULT_TIER=standard

# --- Meta-builder Job (Mongo/Postgres seeding, triggered post-provisioning) ---
META_BUILDER_JOB_IMAGE=registry.internal/bridge-meta-builder:2.0.0
META_BUILDER_JOB_NAMESPACE=platform-jobs

# --- Spoke capacity planning (tenants per spoke, by environment) ---
# PROD_SPOKE_CAPACITY=1000
# PROD_SPOKE_SCALE_TRIGGER=995
# STAGE_SPOKE_CAPACITY=3
# STAGE_SPOKE_SCALE_TRIGGER=2

# --- Crossplane (prod-only new-spoke OKE provisioning) ---
# Set to true only once Crossplane + your OKE Composition/XRD are installed
# on the hub cluster. Leave false for stage and for local/no-cluster
# testing -- see poc/.env.nocluster.example.
CROSSPLANE_ENABLED=false
CROSSPLANE_API_VERSION=oke.platform.example.com/v1alpha1
CROSSPLANE_KIND=OKEClusterClaim
CROSSPLANE_PLURAL=okeclusterclaims
CROSSPLANE_CLAIM_NAMESPACE=platform-infra
# CROSSPLANE_COMPOSITION_REF=oke-standard
CROSSPLANE_DEFAULT_REGION=us-ashburn-1
CROSSPLANE_DEFAULT_NODE_COUNT=3
CROSSPLANE_PROVISION_TIMEOUT_SECONDS=1800
CROSSPLANE_POLL_INTERVAL_SECONDS=15

# --- Hub cluster access (Tenant/SpokeCluster CRs + Crossplane claims) ---
# Leave both unset when the operator runs on the hub itself (in-cluster
# config). Set both only for local/dev access to a real hub from outside it.
# HUB_KUBECONFIG_PATH=/secrets/kube/hub-config
# HUB_KUBE_CONTEXT=hub

# --- Vault ---
# Three independent uses -- see app/vault_bootstrap.py and app/services/vault_service.py:
#  1. If VAULT_ADDR is set, the operator's OWN config (any of the vars in
#     this file) can be fetched from Vault at VAULT_CONFIG_PATH instead --
#     real env vars/.env always win, Vault only fills gaps.
#  2. If VAULT_ENABLED=true, the operator reads/writes COMMON config (shared
#     Redis/Postgres/Mongo hosts, JWT signing config -- same for every
#     tenant) at secret/{VAULT_COMMON_SECRET_PATH}, managed via
#     PUT/GET /api/v1/vault/common. Falls back to the TENANT_* defaults
#     below when disabled or not yet pushed.
#  3. If VAULT_ENABLED=true, the operator writes each new tenant's initial,
#     TENANT-SPECIFIC secrets (generated credentials merged with the common
#     config above) to Vault (secret/tenants/{tenantId}/{redis,database,mongo,jwt})
#     right before triggering the meta-builder seeding Job, which reads them
#     via safeVault(). Leave false for local/no-cluster testing.
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=CHANGE_ME
# VAULT_TOKEN_FILE=/vault/secrets/token   # e.g. written by a Vault Agent sidecar -- alternative to VAULT_TOKEN
VAULT_KV_MOUNT=secret
VAULT_CONFIG_PATH=tenant-operator/config
VAULT_COMMON_SECRET_PATH=common/config
VAULT_TENANT_SECRET_PREFIX=tenants
VAULT_ENABLED=false

# Fallback/seed values for the common config above (used until something's
# actually pushed to Vault, or whenever VAULT_ENABLED=false) -- NOT this
# operator's own DATABASE_URL below.
TENANT_POSTGRES_HOST=postgres.database.svc.cluster.local
TENANT_POSTGRES_PORT=5432
TENANT_MONGO_HOST=mongo.database.svc.cluster.local
TENANT_MONGO_PORT=27017
TENANT_REDIS_HOST=redis.database.svc.cluster.local
TENANT_REDIS_PORT=6379

# --- Database (runs on your Database VM) ---
DATABASE_URL=postgresql+psycopg2://tenant_operator:CHANGE_ME@db-vm.internal:5432/tenant_operator

# --- Git (GitOps source of truth) ---
GIT_REPO_URL=git@github.com:your-org/tenant-config.git
GIT_BRANCH=main
GIT_LOCAL_PATH=/data/tenant-config
GIT_AUTHOR_NAME=tenant-operator
GIT_AUTHOR_EMAIL=tenant-operator@your-org.com

# Pick ONE auth mechanism:
GIT_SSH_KEY_PATH=/secrets/git/id_ed25519
# GIT_HTTPS_TOKEN=ghp_xxx
# GIT_HTTPS_USERNAME=git

# --- Argo CD ---
ARGOCD_SERVER=https://argocd.hub.internal
ARGOCD_TOKEN=CHANGE_ME
ARGOCD_VERIFY_TLS=true
ARGOCD_APPSET_NAME=workplace

# Fail a tenant's own rollout early if Argo CD is unreachable this many
# consecutive polls, instead of silently retrying for the full
# PROVISIONING_TIMEOUT_SECONDS. Only applies during onboarding/updates --
# tenants are not monitored after they reach RUNNING.
ARGOCD_UNREACHABLE_FAIL_AFTER=5

# --- Kubernetes ---
# kubeconfig with one context per cluster: hub, spoke-1, spoke-2, ...
KUBECONFIG_PATH=/secrets/kube/config

# --- Cluster registry ---
CLUSTERS_CONFIG_PATH=clusters.yaml
CLUSTER_MAX_TENANTS=1000

# --- Provisioning behavior ---
PROVISIONING_POLL_INTERVAL_SECONDS=5
PROVISIONING_TIMEOUT_SECONDS=900
