# No-cluster local test config. Use with poc/run_local_no_cluster.py, which
# monkeypatches away the Argo CD/Kubernetes calls -- no kind, no Argo CD, no
# real spoke fleet needed at all.

DATABASE_URL=sqlite:///./poc-nocluster.db

# Which environment this run simulates: "stage" (3/spoke, notify at 2) or
# "prod" (1000/spoke, scale-out job at 995). Override the thresholds below
# to something small so you can actually reach them by hand.
ENVIRONMENT=stage

# Fill in with the path printed by poc/init_local_gitops_repo.sh
GIT_REPO_URL=/absolute/path/to/tenant-operator-poc/tenant-config-bare.git
GIT_BRANCH=main
GIT_LOCAL_PATH=/tmp/tenant-operator-poc-nocluster-workdir
GIT_AUTHOR_NAME=tenant-operator-poc
GIT_AUTHOR_EMAIL=poc@example.com

CLUSTERS_CONFIG_PATH=poc/clusters.nocluster.yaml
PROVISIONING_POLL_INTERVAL_SECONDS=1
PROVISIONING_TIMEOUT_SECONDS=30

# Small thresholds so the capacity/scale-out logic is reachable in a few
# curl calls instead of needing hundreds of tenants:
STAGE_SPOKE_CAPACITY=3
STAGE_SPOKE_SCALE_TRIGGER=2
PROD_SPOKE_CAPACITY=5
PROD_SPOKE_SCALE_TRIGGER=3

# Not needed -- argocd_service/kubernetes_service calls never happen for
# real, see poc/run_local_no_cluster.py.
# ARGOCD_SERVER / ARGOCD_TOKEN / KUBECONFIG_PATH intentionally omitted.

# Crossplane defaults to disabled (see app/config.py), which is what keeps
# the prod-scale-out test in step 8 of the local guide working without a
# real hub cluster -- it uses the log-only simulation instead of applying a
# real Crossplane claim. Leave this unset/false here.
# CROSSPLANE_ENABLED=false

# Vault also defaults to disabled -- the operator logs/echoes the initial
# tenant secrets it would write instead of needing a real Vault server.
# VAULT_ENABLED=false
