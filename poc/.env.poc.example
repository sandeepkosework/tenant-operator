# POC config: single kind cluster plays both "hub" and "spoke-1", local bare
# git repo instead of GitHub, Postgres via docker-compose. No SSH keys, no
# Argo CD token beyond a POC-scoped one, no real spoke fleet.

DATABASE_URL=postgresql+psycopg2://tenant_operator:poc_password@localhost:5432/tenant_operator

# Fill in the path printed by poc/init_local_gitops_repo.sh
GIT_REPO_URL=/absolute/path/to/tenant-operator-poc/tenant-config-bare.git
GIT_BRANCH=main
GIT_LOCAL_PATH=/tmp/tenant-operator-poc-workdir
GIT_AUTHOR_NAME=tenant-operator-poc
GIT_AUTHOR_EMAIL=poc@example.com
# no GIT_SSH_KEY_PATH / GIT_HTTPS_TOKEN needed -- it's a local filesystem repo

# Fill in after: kubectl port-forward svc/argocd-server -n argocd 8080:443
ARGOCD_SERVER=https://localhost:8080
# Fill in after: argocd admin initial-password / your own token
ARGOCD_TOKEN=CHANGE_ME
ARGOCD_VERIFY_TLS=false

# Fill in with: kind get kubeconfig --name tenant-poc > /tmp/poc-kubeconfig
KUBECONFIG_PATH=/tmp/poc-kubeconfig

CLUSTERS_CONFIG_PATH=poc/clusters.poc.yaml
PROVISIONING_POLL_INTERVAL_SECONDS=3
PROVISIONING_TIMEOUT_SECONDS=180
