# Generated by tenant-operator. Do not edit by hand — changes will be
# overwritten on the next tenant update. Source of truth: PostgreSQL `tenants` table.
#
# argocdClusterServer is read by the Argo CD ApplicationSet's own
# destination.server templating (see the bridge-tenants ApplicationSet) --
# NOT a helm-chart-bridge value, just metadata the operator needs to tell
# Argo CD where to deploy this tenant. Harmless if the chart doesn't
# reference it (it doesn't).
argocdClusterServer: {{ argocd_cluster_server }}

# tenant.id/namespace are also read directly by the ApplicationSet's git
# generator templating ({{ '{{' }}tenant.id{{ '}}' }} / {{ '{{' }}tenant.namespace{{ '}}' }}) to name the
# generated Application and pick its destination namespace -- these are the
# SAME fields helm-chart-bridge's own values.yaml consumes at render time
# (tenant.id/name/namespace/domain), so no redundant global.* mirror is
# needed the way qraie-bridge's own chart required one.
tenant:
  id: {{ tenant_slug }}
  name: {{ tenant_name }}
  namespace: {{ namespace }}
  domain: {{ domain }}

imagePullSecrets:
  - ocir-regcred
{% if vault_server %}

# This cluster's Vault runs on a different cluster than this tenant's own
# workloads (see ClusterInfo.vault_server) -- the chart's own in-cluster
# DNS default (vault.vault.svc) only resolves on whichever cluster Vault
# itself runs on, so it has to be overridden here per-cluster.
vault:
  server: {{ vault_server }}
{% endif %}
{% if ingress_class_name %}

# This cluster's ingress-nginx controller was installed with a non-default
# --ingress-class -- the chart's own default ("nginx") only matches a
# plain-named IngressClass, so it has to be overridden per-cluster (see
# ClusterInfo.ingress_class_name).
ingress:
  className: {{ ingress_class_name }}
{% endif %}
{% if disabled_services %}

# From this tenant's `services: {name: bool}` request field -- see
# TenantCreateRequest.services and helm-chart-bridge/values.yaml's
# `disabledServices` comment for why this is its own list rather than a
# `services:` override (Helm replaces an entire list wholesale on override,
# so a per-tenant `services:` override would have to repeat the chart's
# whole 32-entry array just to disable a couple).
disabledServices:
{% for s in disabled_services %}
  - {{ s }}
{% endfor %}
{% endif %}
