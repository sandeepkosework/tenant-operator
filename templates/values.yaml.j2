# Generated by tenant-operator. Do not edit by hand — changes will be
# overwritten on the next tenant update. Source of truth: PostgreSQL `tenants` table.
#
# argocdClusterServer is read by the ApplicationSet's destination.server
# (see templates/applicationset.example.yaml) -- NOT a Helm chart value,
# just metadata the operator needs to tell Argo CD which cluster to deploy
# this tenant onto. Harmless if your chart doesn't reference it.
argocdClusterServer: {{ argocd_cluster_server }}

# tenant.id feeds this chart's own Vault Agent Injector path (see its
# deployment.yaml's vault.hashicorp.com/agent-inject-secret-* annotations)
# -- must be tenant_slug (the id-prefixed identifier), not the bare tenant
# name, since that's exactly what vault_service.write_initial_tenant_secrets()
# wrote to. See app/models/tenant.py's Tenant.slug docstring for why.
tenant:
  id: {{ tenant_slug }}
  environment: {{ environment }}
  namespace: {{ namespace }}

image:
  repository: {{ application }}
  tag: "{{ version }}"

replicaCount: {{ replica_count }}

database:
  host: postgres.database.svc.cluster.local
  name: {{ tenant_name | replace('-', '_') }}

storage:
  size: {{ database_size }}

resources:
  requests:
    cpu: "{{ cpu_request }}"
    memory: "{{ memory_request }}"
  limits:
    cpu: "{{ cpu_limit }}"
    memory: "{{ memory_limit }}"

ingress:
  enabled: true
  host: {{ tenant_name }}.{{ environment }}.your-domain.com
